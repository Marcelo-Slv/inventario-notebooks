# Copie este arquivo para .env e preencha os valores localmente.
# O arquivo .env esta no .gitignore e nunca deve ser enviado ao GitHub.

LOGIN_PROFESSOR=
SENHA_PROFESSOR=
LOGIN_ADMIN=
SENHA_ADMIN=

# Caminho da planilha protegida (.enc) ou da planilha XLSX original.
PLANILHA_PATH=
# Senha usada para descriptografar a planilha protegida.
SENHA_PLANILHA=

# Servidor
HOST=127.0.0.1
PORTA=8000
# Use 1 quando estiver atraves de HTTPS/proxy com TLS.
HTTPS=0
